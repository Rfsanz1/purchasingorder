{
    "private": true,
    "type": "module",
    "workspaces": [
        "apps/*",
        "frontend/artifacts/pos-app"
    ],
    "scripts": {
        "dev:backend": "pnpm --filter @erp-modern/backend start:dev",
        "dev:frontend": "pnpm --filter @erp-modern/frontend dev",
        "dev:web": "pnpm --filter @gm/web dev",
        "dev:sales": "pnpm --filter @gm/sales-app dev",
        "dev:gudang": "pnpm --filter @gm/gudang-app dev",
        "dev:driver": "pnpm --filter @gm/driver-app dev",
        "dev:pos-new": "pnpm --filter @gm/pos-app dev",
        "dev:pos": "pnpm --filter @workspace/pos-app dev",
        "dev:all": "concurrently \"pnpm dev:backend\" \"pnpm dev:web\" \"pnpm dev:sales\" \"pnpm dev:gudang\" \"pnpm dev:driver\" \"pnpm dev:pos-new\"",
        "build:backend": "pnpm --filter @erp-modern/backend build",
        "build:frontend": "pnpm --filter @erp-modern/frontend build",
        "build:web": "pnpm --filter @gm/web build",
        "build:sales": "pnpm --filter @gm/sales-app build",
        "build:gudang": "pnpm --filter @gm/gudang-app build",
        "build:driver": "pnpm --filter @gm/driver-app build",
        "build:pos-new": "pnpm --filter @gm/pos-app build",
        "build:all": "pnpm build:backend && pnpm build:web && pnpm build:sales && pnpm build:gudang && pnpm build:driver && pnpm build:pos-new"
    },
    "dependencies": {
        "eventemitter3": "^5.0.4"
    }
}
