modules = ["nodejs-20", "web"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
run = ["bash", "start-production.sh"]
build = ["bash", "-c", "composer install --no-dev --optimize-autoloader --no-interaction"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "NestJS Backend"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/backend && node_modules/.bin/prisma generate 2>/dev/null || true; PORT=6000 node_modules/.bin/tsx watch src/main.ts"
waitForPort = 6000

[[workflows.workflow]]
name = "Next.js Frontend"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/frontend && node_modules/.bin/next dev -p 5000"
waitForPort = 5000

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Next.js Frontend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "NestJS Backend"

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true
integrations = ["javascript_database:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 6000
externalPort = 6000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
APP_NAME = "Gentong Mas ERP"
APP_LOCALE = "id"
APP_FALLBACK_LOCALE = "id"
DB_CONNECTION = "pgsql"
DB_HOST = "helium"
DB_PORT = "5432"
DB_DATABASE = "heliumdb"
DB_USERNAME = "postgres"
DB_SSLMODE = "disable"
SESSION_DRIVER = "file"
CACHE_STORE = "file"
QUEUE_CONNECTION = "sync"
SESSION_SAME_SITE = "none"
SESSION_SECURE_COOKIE = "true"
APP_KEY = "base64:77bISlISnpVyiKgTWeA+WYUcrOa0KZSySnHqiVg+B3A="
JWT_SECRET = "erp-gentong-mas-jwt-secret-y9stx3wyz6"
JWT_EXPIRES_IN = "7d"
JWT_REFRESH_EXPIRES_IN = "30d"
BACKEND_URL = "http://localhost:6000"
PORT = "6000"
NODE_ENV = "development"
JWT_REFRESH_SECRET = "erp-gm-refresh-secret-2024"

[userenv.development]
