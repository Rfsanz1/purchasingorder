modules = ["nodejs-20", "web", "php-8.2"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
run = ["bash", "start-production.sh"]
build = ["bash", "-c", "composer install --no-dev --optimize-autoloader --no-interaction"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "NestJS Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Sales App"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Gudang App"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "POS App"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Driver App"

[[workflows.workflow]]
name = "NestJS Backend"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/backend && npx prisma generate && npx prisma db push --accept-data-loss 2>/dev/null; node --loader ts-node/esm prisma/seed.ts 2>/dev/null; PORT=6000 pnpm start:dev"
waitForPort = 6000

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/web && pnpm dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Sales App"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/sales-app && pnpm dev"
waitForPort = 3002

[[workflows.workflow]]
name = "Gudang App"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/gudang-app && pnpm dev"
waitForPort = 3003

[[workflows.workflow]]
name = "POS App"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/pos-app && pnpm dev"
waitForPort = 3001

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Driver App"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/driver-app && pnpm dev"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true
integrations = ["javascript_database:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 3002
externalPort = 5000

[[ports]]
localPort = 3003
externalPort = 3003

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 6000
externalPort = 6000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 23287
externalPort = 5173

[[ports]]
localPort = 23289
externalPort = 4200

[[ports]]
localPort = 23636
externalPort = 8000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
APP_NAME = "Gentong Mas ERP"
APP_LOCALE = "id"
APP_FALLBACK_LOCALE = "id"
DB_CONNECTION = "pgsql"
DB_HOST = "helium"
DB_PORT = "5432"
DB_DATABASE = "heliumdb"
DB_USERNAME = "postgres"
DB_SSLMODE = "disable"
SESSION_DRIVER = "file"
CACHE_STORE = "file"
QUEUE_CONNECTION = "sync"
SESSION_SAME_SITE = "none"
SESSION_SECURE_COOKIE = "true"
APP_KEY = "base64:77bISlISnpVyiKgTWeA+WYUcrOa0KZSySnHqiVg+B3A="
JWT_SECRET = "erp-gentong-mas-jwt-secret-y9stx3wyz6"
JWT_EXPIRES_IN = "7d"
JWT_REFRESH_EXPIRES_IN = "30d"
BACKEND_URL = "http://localhost:6000"
PORT = "6000"
NODE_ENV = "development"
JWT_REFRESH_SECRET = "erp-gm-refresh-secret-2024"

[userenv.development]
